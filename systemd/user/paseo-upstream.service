[Unit]
Description=Paseo Upstream Daemon (user)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/yang/docker-com
EnvironmentFile=-/home/yang/docker-com/.env_paseo_upstream
EnvironmentFile=-/home/yang/docker-com/.env_luminexus
Environment=PASEO_HOME=/home/yang/.paseo-lumeny
Environment=PASEO_LISTEN=0.0.0.0:14097
Environment=PATH=/home/yang/git/paseo-backend-v0.12.0/node_modules/.bin:/home/yang/.local/share/mise/installs/node/lts/bin:/home/yang/.npm/bin:/home/yang/.local/bin:/home/yang/.local/share/mise/shims:/home/yang/micromamba/envs/main/bin:/home/yang/.local/share/mamba/envs/main/bin:/home/yang/.local/share/mise/installs/codex/latest:/home/yang/.local/share/mise/installs/opencode/latest:/home/yang/.local/share/mise/installs/npm-anthropic-ai-claude-code/latest/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env paseo daemon run --home /home/yang/.paseo-lumeny
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
